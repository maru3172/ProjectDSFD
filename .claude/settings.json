{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/Source Code/ProjectProject01/Tools/BuildGuard/BlockSourceEditsDuringBuild.ps1\"; [ -f \"$f\" ] || exit 0; powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$f\"",
            "timeout": 15,
            "statusMessage": "빌드 실행 여부 확인"
          }
        ]
      }
    ]
  }
}
