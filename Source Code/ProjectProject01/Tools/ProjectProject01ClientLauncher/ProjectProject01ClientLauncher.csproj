<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProjectDFSDClientLauncher</AssemblyName>
    <Product>백화점 화재사건</Product>
    <Company>Team DSFD</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- Game-specific values; without this file the launcher uses generic defaults (LauncherProfile.cs). -->
    <None Update="launcher.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
